#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 900   // mousescroll SPEED

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off it the key is held for 3 seconds or longer.
};

&mt {
    tapping-term-ms = <500>;
    flavor = "balanced";
};

&lt { tapping-term-ms = <300>; };

/ {
    behaviors {
        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        TD01: TD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD01";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PERIOD>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;

            tap-ms = <20>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Combo_CLR_BT {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <13 0>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&kp ESC         &mt F1 N1     &mt F2 N2  &mt F3 N3    &mt F4 N4        &mt F5 N5  &kp UP     &mmv MOVE_UP     &mt F6 N6  &mt F7 N7  &mt F8 NUMBER_8      &mt F9 N9                &mt F10 N0         &kp BACKSPACE
&kp TAB         &kp Q         &kp W      &kp E        &kp R            &kp T      &kp LEFT   &mmv MOVE_RIGHT  &kp Y      &kp U      &kp I                &kp O                    &kp P              &mt PLUS KP_EQUAL
&kp LEFT_SHIFT  &kp A         &kp S      &kp D        &kp F            &kp G      &mkp LCLK  &mkp RCLK        &kp H      &kp J      &kp K                &kp L                    &mt COLON SEMI     &mt RIGHT_SHIFT ENTER
&kp LEFT_SHIFT  &kp Z         &kp X      &kp C        &kp V            &kp B      &kp RIGHT  &mmv MOVE_LEFT   &kp N      &kp M      &mt LESS_THAN COMMA  &mt GREATER_THAN PERIOD  &mt QUESTION FSLH  &mt RIGHT_SHIFT APOS
&kp LALT        &kp LEFT_GUI  &kp DEL    &lt 1 SPACE  &mt LCTRL SPACE  &kp RET    &kp DOWN   &mmv MOVE_DOWN   &kp RET    &kp SPACE  &kp SPACE            &kp BACKSPACE            &kp LEFT_GUI       &kp RIGHT_CONTROL
            >;

            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        lower_layer {
            display-name = "Lower Layer";
            bindings = <
&kp SPACE  &kp SPACE  &kp F2  &kp F3  &kp F4  &kp F5    &mmv MOVE_UP     &kp UP     &kp F6              &kp F7                       &kp F8                  &kp F9  &kp F10                &mt UNDER KP_MINUS
&trans     &trans     &trans  &trans  &trans  &trans    &mmv MOVE_LEFT   &kp RIGHT  &kp LS(LBRC)        &kp N7                       &kp N8                  &kp N9  &mt LBRC LEFT_BRACKET  &mt RBRC RBKT
&trans     &trans     &trans  &trans  &trans  &trans    &trans           &trans     &mt UNDER KP_MINUS  &mt LEFT_BRACE LEFT_BRACKET  &mt RBRC RIGHT_BRACKET  &kp N6  &kp BSLH               &mt DOUBLE_QUOTES APOS
&trans     &trans     &trans  &trans  &trans  &trans    &mmv MOVE_RIGHT  &kp LEFT   &kp LS(STAR)        &kp N1                       &kp N2                  &kp N3  &kp EQUAL              &trans
&trans     &trans     &trans  &trans  &trans  &mkp MB3  &mmv MOVE_DOWN   &kp DOWN   &kp ENTER           &kp BACKSPACE                &trans                  &trans  &trans                 &trans
            >;

            sensor-bindings = <&Scroll_RL>, <&Scroll_RL>;
        };

        raise_layer {
            display-name = "Raise Layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp 0 0>, <&inc_dec_kp 0 0>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp 0 0>, <&inc_dec_kp 0 0>;
        };
    };
};
